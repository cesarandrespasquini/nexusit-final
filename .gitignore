# Examples:
#   node_modules/           # ignore node_modules folder entirely
#   *.txt                   # ignore all .txt files
#   !foo.txt                # include foo.txt even if parent directory is excluded
#   docs/*.pdf              # ignore pdf files in docs/ folder only
#   build/                  # ignore entire build folder
#   *.log                   # ignore all log files
#
# For more information: https://git-scm.com/docs/gitignore

